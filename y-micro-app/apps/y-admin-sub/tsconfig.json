{
  "extends": "../../configs/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "types": ["vite/client" , "node"],
    "typeRoots": [
      "./node_modules/@types",
      "./types"
    ],
    "paths": {
      "@/*": ["./src/*"]
    },

    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    //    "src/**/**/*.d.ts",
    "src/**/**/**/*.d.ts",
    "types/**/*",
    "src/components.d.ts",
    "src/auto-imports.d.ts",
    "vite.config.ts",
    "vite-plugins/**/*.ts"
  ]
}
