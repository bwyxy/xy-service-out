{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "飞鸽即时通讯",
  "version": "0.1.0",
  "identifier": "com.xy.chat.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:9001",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "飞鸽即时通讯",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
