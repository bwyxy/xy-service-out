# y-chat-sub 环境变量模板
# 复制为 .env.development / .env.production 后按各环境填写真实值

# 运行模式：development 时启用 qiankun 微前端 dev 模式
VITE_NODE_ENV=development

# 后端接口地址
# 本地开发通常走 vite 代理，填 /api
# 生产环境填线上完整地址，例如 https://your-domain.com/chat-api
VITE_BASE_API_URL=/api

# 读取悟空 IM 连接地址的 Cookie 名称（由登录接口写入）
VITE_WSS_KEY=xy_wss_key
