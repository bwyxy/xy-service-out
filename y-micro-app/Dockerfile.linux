# Linux 安装包构建镜像（Tauri v2）
#
# 在 y-micro-app 目录执行：
#   docker build -f Dockerfile.linux -t y-chat-linux .
#   docker run --rm \
#     -v y-chat-cargo-target:/app/apps/y-chat-sub/src-tauri/target \
#     -v "$PWD/dist-linux":/out \
#     y-chat-linux sh -c \
#     'pnpm tauri build -- --bundles deb,rpm,appimage && cp -r src-tauri/target/release/bundle/* /out/'
#
# 产物（dist-linux/）：deb / rpm / appimage

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
# 容器内无 FUSE，AppImage 打包需启用自解压运行
ENV APPIMAGE_EXTRACT_AND_RUN=1

# Tauri v2 所需的 Linux 系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential curl wget file git ca-certificates pkg-config \
      libwebkit2gtk-4.1-dev \
      libssl-dev \
      libayatana-appindicator3-dev \
      librsvg2-dev \
      libgtk-3-dev \
      libfuse2 \
      rpm \
    && rm -rf /var/lib/apt/lists/*

# Rust 工具链
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable
ENV PATH="/usr/local/cargo/bin:${PATH}"

# Node.js 22 + pnpm（与仓库 packageManager 保持一致）
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate

WORKDIR /app
COPY . .

# 安装 workspace 依赖，并先构建 @xy/utils 等被引用的内部包（其入口指向 dist/）
RUN pnpm install --frozen-lockfile \
 && pnpm build:packages

WORKDIR /app/apps/y-chat-sub
CMD ["pnpm", "tauri", "build", "--", "--bundles", "deb,rpm,appimage"]