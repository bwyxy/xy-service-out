  },
  "keywords": [
    "utils",
    "web",
    "toolbox",
    "typescript"
  ],
  "devDependencies": {
    "@rspress/core": "^2.0.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "path": "^0.12.7"
  }
}
