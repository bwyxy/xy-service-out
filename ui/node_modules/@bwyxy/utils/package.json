{
  "name": "@bwyxy/utils",
  "version": "1.0.0-alpha.0",
  "description": "web 开发工具包",
  "license": "MIT",
  "author": "bwyxy",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/bwyxy/y-utils.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
