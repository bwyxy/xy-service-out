	&:last-child {
		margin-left: 120rpx;
	}
}

.tabbar-item {
	flex: 1;
	height: 100%;
	display: flex;  
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 8rpx;
	image {
		width: 42rpx;
		height: 42rpx;
	}
