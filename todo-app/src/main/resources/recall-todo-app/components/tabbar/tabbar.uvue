<template>
	<view 
		class="tabbar" 
		:style="{ paddingBottom: (safeAreaInsets ? safeAreaInsets.bottom : 0) + 'px' }"
	>
		<view class="tabbar-container">
			<view class="tabbar-container-box">
				<view class="tabbar-item" @click="toPage('/pages/index/index')">
					<image v-if="path === 'home'" src="@/static/tabbar/renwu.png"></image>
					<image v-else src="@/static/tabbar/renwu-copy.png"></image>
					<text :class="path === 'home' ? 'active-tabbar' : ''">任务</text>
				</view>
				<view class="tabbar-item" @click="toPage('/pages/schedule/index')">
					<image v-if="path === 'schedule'" src="@/static/tabbar/gongju.png"></image>
					<image v-else src="@/static/tabbar/gongju-copy.png"></image>
					<text :class="path === 'schedule' ? 'active-tabbar' : ''">工具</text>
				</view>
			</view>
			<view class="tabbar-container-box">
				<view class="tabbar-item" @click="toPage('/pages/statistics/index')">
					<image v-if="path === 'statistics'" src="@/static/tabbar/tongji.png"></image>
					<image v-else src="@/static/tabbar/tongji-copy.png"></image>
					<text :class="path === 'statistics' ? 'active-tabbar' : ''">统计</text>
				</view>
				<view class="tabbar-item" @click="toPage('/pages/user/index')">
					<image v-if="path === 'user'" src="@/static/tabbar/wo.png"></image>
					<image v-else src="@/static/tabbar/wo-copy.png"></image>
					<text :class="path === 'user' ? 'active-tabbar' : ''">我的</text>
				</view>
			</view>
		</view>
	</view>
	
	<view 
		class="add-todo" 
		:style="{bottom: (safeAreaInsets ? (`calc(${safeAreaInsets.bottom}px + 30rpx)`) : '30rpx')}"
		@click="toAddTask"
	>
		<view class="add-todo-content">
			<up-icon name="plus" color="#fff" size="54rpx"></up-icon>
		</view>
	</view>
	
	<model-popup v-model="isAddTask">
		<add-task @close="isAddTask = false"></add-task>
	</model-popup>
</template>

<script lang="uts" setup>
import { state } from '@/store/modules/app';
import AddTask from '@/pages/add-task/index.uvue'

const isAddTask = ref<boolean>(false)

const safeAreaInsets = computed(() => {
	return state.safeAreaInsets
})

defineProps({
	path: {
		type: String,
		required: true,
		default: ''
	}
})

const toPage = (url :string) :void => {
	uni.switchTab({
		url: url
	})
}

const toAddTask = () => {
	// #ifdef MP-WEIXIN
	isAddTask.value = true
	return
	// #endif
	uni.navigateTo({
		url: '/pages/add-task/index'
	})
}
</script>

