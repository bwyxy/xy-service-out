.add-todo {
	width: 120rpx;
	height: 120rpx;
	background: #fff;
	border-radius: 50%;
	box-shadow: 0 -6rpx 4rpx $color-shadow;
	z-index: 100;
	display: flex;
	align-items: center;
	justify-content: center;
	position: absolute;
	left: calc(50% - 60rpx);
	&-content {
		width: 100rpx;
		height: 100rpx;
		background: $theme-color;
		border-radius: 50%;
		display: flex;
		align-items: center;
