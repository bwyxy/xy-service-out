<template>
	<view class="calendar-box">
		<view class="calendar-head">
			<text v-for="item in dayNameList" :key="item.chineseShortName">{{ item.chineseShortName }}</text>
		</view>
		<view class="calendar-container" :style="{ height: isWeek ? '100rpx' : '500rpx' }">
			<view class="calendar-main" :style="{ top: isWeek ? `calc(${calendarTop} * -100rpx)` : '0' }">
				<view v-for="(item, index) in calendars" :key="index" class="calendar-main-item">
					<view 
						v-for="row in item" 
						:key="row.dateNumber" 
						:class="[
							'calendar-main-row',
							{ 'date-previous': row.dateType === 'previous' },
							{ 'date-next': row.dateType === 'next' },
							{ 'today-row': IsToday(row.dateObj) },
							{ 'is-selected': IsSelected(row.dateObj)  }
						]"
						@click="selectDate(row.dateObj)"
					>
						<view class="day-content">
							<text>{{ row.dateNumber }}</text>
							<text class="data-lunarDay">{{ getLunarDate(row.dateObj).lunarDayCN }}</text>
						</view>
					</view>
				</view>
			</view>
		</view>
		<view class="calendar-down">
			<view class="calendar-down-content" @click="isWeek = !isWeek">
				<up-icon :name="isWeek ? 'arrow-down' : 'arrow-up'" color="#888" size="28rpx"></up-icon>
			</view>
		</view>
	</view>
</template>

<script lang="uts" setup>
import { ref, onMounted, computed } from 'vue'
import { getCalendar, dayNameList, CalendarData, formatDateTime } from '@bwyxy/utils'
import { getLunarDate } from 'chinese-days'

const cureentDate = ref<Date>(new Date())
const isWeek = ref<boolean>(true)
const calendars = ref<CalendarData[][]>([])

const emit = defineEmits(['select'])

const calendarTop = computed(() => {
	if (isWeek.value) {
		let top = 0
		const today = cureentDate.value
		const calendars = getCalendar(cureentDate.value).originData
		
		calendars.forEach((item :CalendarData[], idx) => {
			const index = item.findIndex(row => formatDateTime(row.dateObj, 'yyyy-MM-dd') === formatDateTime(today, 'yyyy-MM-dd'))
			
			if (index > -1) {
				top = idx
			}
		})
		
		return top
	} else {
		return 0
	}
})

const IsToday = (date :Date) => {
	const today = new Date()
	
	return formatDateTime(date, 'yyyy-MM-dd') === formatDateTime(today, 'yyyy-MM-dd')
}

const IsSelected = (date :Date) => {
	return formatDateTime(date, 'yyyy-MM-dd') === formatDateTime(cureentDate.value, 'yyyy-MM-dd')
}

const selectDate = (date :Date) => {
	cureentDate.value = date
	calendars.value = getCalendar(cureentDate.value).originData
	emit('select', cureentDate.value)
}

onMounted(() => {
	calendars.value = getCalendar(cureentDate.value).originData
})
</script>

<style lang="scss">
@mixin flexCenter {
	display: flex;
	align-items: center;
	justify-content: center;
}
	
.calendar-box {
	background: #fff;
	box-sizing: border-box;
	border-bottom: 1rpx solid #f0f0f0;
	padding-bottom: 12rpx;
	transition: 3s;
}

.calendar-head{
	height: 60rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	text {
		flex: 1;
		font-size: 24rpx;
		font-weight: 700;
		color: #1f1f1f;
		text-align: center;
	}
}

.calendar-container {
	width: 100%;
	height: 100rpx;
	transition: .4s;
	position: relative;
}

.calendar-main {
	width: 100%;
	display: flex;
	flex-direction: column;
	transition: .4s;
	position: absolute;
	left: 0;
	top: 0;
	&-item {
		width: 100%;
		height: 100rpx;
		display: flex;
		flex-direction: row;
	}
	&-row {
		flex: 1;
		flex-direction: column;
		@include flexCenter;
		font-size: 28rpx;
		line-height: 26rpx;
		color: #1f1f1f;
		letter-spacing: 1px;
	}
}

.day-content {
	width: 90rpx;
	height: 90rpx;
	flex-direction: column;
	@include flexCenter;
	z-index: 1;
	position: absolute;
}
	
.data-lunarDay {
	font-size: 18rpx;
	color: #1f1f1f;
	letter-spacing: 1px;
}

.is-selected {
	position: relative;
	&::after {
		content: '';
		width: 80rpx;
		height: 80rpx;
		background: $theme-color;
		border-radius: 50rpx;
		opacity: .1;
		position: absolute;
	}
}

.date-previous, .date-next {
	color: #ccc;
	.data-lunarDay {
		color: #ccc;
	}
}

.today-row {
	color: $theme-color;
	.data-lunarDay {
		color: $theme-color;
	}
}


.calendar-down {
	width: 100%;
	display: flex;
	flex-direction: row;
	justify-content: center;
	&-content {
		width: 240rpx;
		height: 100%;
		display: flex;
		flex-direction: row;
		justify-content: center;
	}
}
</style>