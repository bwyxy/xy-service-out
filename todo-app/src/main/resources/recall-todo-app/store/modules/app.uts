import { reactive } from 'vue'

const loadPersistedState = () => {
	try {
	    const saved = uni.getStorageSync('app_state')
	    if (saved) {
	      return JSON.parse(saved)
	    }
	  } catch (e) {
	    console.error('读取持久化数据失败', e)
	  }
	  return { token: '', userInfo: null }
}

const initialState = loadPersistedState()
export const state = reactive(initialState)

const persist = () => {
  try {
    uni.setStorageSync('app_state', JSON.stringify({
      ...state
    }))
  } catch (e) {
    console.error('保存持久化数据失败', e)
  }
}

export const initSystemInfo = () => {
	console.log('1111')
	uni.getSystemInfo({
		success(res) {
			state.safeAreaInsets = res.safeAreaInsets
			persist()
		}
	})
}